local function applyWeaponSettings(settings)
	disconnectAll()
	if not container then return end

	local weaponAttrs = {
		["Sniper"] = {
			AimDelay            = settings["Sniper"].AimDelay,
			Scope               = settings["Sniper"].Scope,
			AimFieldOfView      = settings["Sniper"].Zoom,
			CrosshairSize       = settings["Sniper"].CrossHairSize,
			AimMouseSensitivity = settings["Sniper"].AimMouseSensitivity,
			Recoil              = 0,
			Instability         = 0
		},
		["G36"] = {
			AimFieldOfView      = settings["G36"].Zoom,
			CrosshairSize       = settings["G36"].CrossHairSize,
			AimDelay            = settings["G36"].AimDelay,
			AimMouseSensitivity = settings["G36"].AimMouseSensitivity,
			Scope               = settings["G36"].Scope,
			Recoil              = 5,
			Instability         = 5
		}
	}

	local function applyToInst(inst)
		local attrs = weaponAttrs[inst.Name]
		if attrs then
			for attr, value in pairs(attrs) do
				inst:SetAttribute(attr, value)
			end
		end
	end

	for _, inst in ipairs(container:GetChildren()) do
		applyToInst(inst)
	end

	local conn = container.ChildAdded:Connect(function(inst)
		task.wait()
		applyToInst(inst)
	end)
	table.insert(activeConnections, conn)
end

