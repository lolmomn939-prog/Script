-- [أ] نظام الإبادة الشاملة المستمر
local function superClean()
    for _, item in pairs(workspace:GetChildren()) do
        local isMyVehicle = (item.Name == lp.Name or item == vehicle)
        local isMyChar = (item == char or item:IsAncestorOf(char))
        local isEssential = (item:IsA("Camera") or item:IsA("Terrain") or item.Name == "Vehicles")
        if not (isMyVehicle or isMyChar or isEssential) then
            pcall(function() item:Destroy() end)
        end
    end
    local vFolder = workspace:FindFirstChild("Vehicles")
    if vFolder then
        for _, v in pairs(vFolder:GetChildren()) do
            if v.Name ~= lp.Name then pcall(function() v:Destroy() end) end
        end
    end
end
RunService.Heartbeat:Connect(superClean)

-- [ب] دالة الـ Raycast لتحديد ارتفاع الأرض فقط
local function GetGroundHeight(currentPos)
    local rayOrigin = currentPos + Vector3.new(0, 20, 0) 
    local rayDirection = Vector3.new(0, -40, 0) 
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {vehicle, char} -- استثناء سيارتك وشخصيتك
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local raycastResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
    
    if raycastResult then
        return raycastResult.Position.Y + 2.4 -- الارتفاع المناسب للسيارة فوق السطح
    end
    return currentPos.Y
end

